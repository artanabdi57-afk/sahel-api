import React, { useEffect, useState } from "react";
import { Wallet, AlertTriangle } from "lucide-react";
import EntityCrud from "../../components/EntityCrud";
import { apiRequest, formatMoney } from "../../lib/api";
import { EmptyState, ErrorState, LoadingState } from "../../components/AsyncState";

function SalaryPayments() {
  const [teachers, setTeachers] = useState([]);
  const [payments, setPayments] = useState([]);
  const [unpaid, setUnpaid] = useState([]);
  const [form, setForm] = useState({ teacher_id: "", amount: "" });
  const [status, setStatus] = useState({ loading: true, saving: false, error: "" });

  async function load() {
    setStatus((s) => ({ ...s, loading: true, error: "" }));
    try {
      const [teachersRes, paymentsRes, unpaidRes] = await Promise.all([
        apiRequest("/school/teachers"),
        apiRequest("/school/salary-payments"),
        apiRequest("/school/salary-payments/unpaid"),
      ]);
      setTeachers(teachersRes.data || []);
      setPayments(paymentsRes.data || []);
      setUnpaid(unpaidRes.data || []);
      setStatus((s) => ({ ...s, loading: false }));
    } catch (error) {
      setStatus((s) => ({ ...s, loading: false, error: error.message }));
    }
  }
  useEffect(() => { load(); }, []);
  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));

  async function handleSubmit(e) {
    e.preventDefault();
    setStatus((s) => ({ ...s, saving: true, error: "" }));
    try {
      await apiRequest("/school/salary-payments", { method: "POST", body: JSON.stringify({ ...form, amount: Number(form.amount) }) });
      setForm({ teacher_id: "", amount: "" });
      setStatus((s) => ({ ...s, saving: false }));
      await load();
    } catch (error) {
      setStatus((s) => ({ ...s, saving: false, error: error.message }));
    }
  }

  if (status.loading) return <LoadingState />;

  return (
    <div className="space-y-5">
      {unpaid.length > 0 && (
        <div className="panel p-4">
          <h2 className="mb-3 flex items-center gap-2 text-base font-bold text-slate-950">
            <AlertTriangle className="h-5 w-5 text-red-500" /> Not paid this month
          </h2>
          <div className="flex flex-wrap gap-2">
            {unpaid.map((t) => (
              <span key={t.id} className="rounded-full bg-red-50 px-3 py-1.5 text-sm font-semibold text-red-700">
                {t.name} — {formatMoney(t.monthly_salary)}
              </span>
            ))}
          </div>
        </div>
      )}

      <div className="grid gap-5 xl:grid-cols-[380px_1fr]">
        <form onSubmit={handleSubmit} className="panel h-fit p-4">
          <h2 className="mb-4 flex items-center gap-2 text-base font-bold text-slate-950">
            <Wallet className="h-5 w-5 text-blue-600" /> Pay a teacher
          </h2>
          {status.error ? <ErrorState message={status.error} /> : null}
          <div className="space-y-3">
            <select className="field" value={form.teacher_id} onChange={(e) => set("teacher_id", e.target.value)} required>
              <option value="">Choose teacher…</option>
              {teachers.map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
            </select>
            <input className="field" type="number" min="0" step="0.01" placeholder="Amount" value={form.amount} onChange={(e) => set("amount", e.target.value)} required />
          </div>
          <button className="btn-primary mt-4 w-full" disabled={status.saving}>{status.saving ? "Saving…" : "Record payment"}</button>
        </form>

        <div className="panel overflow-hidden">
          <div className="border-b border-slate-100 p-4"><h2 className="text-base font-bold text-slate-950">Salary payment history</h2></div>
          {payments.length === 0 ? (
            <div className="p-4"><EmptyState title="No payments yet" description="Pay a teacher to see it here." /></div>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-full text-left text-sm">
                <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                  <tr><th className="px-4 py-3 font-semibold">Teacher</th><th className="px-4 py-3 font-semibold">Paid</th><th className="px-4 py-3 text-right font-semibold">Amount</th></tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {payments.map((p) => (
                    <tr key={p.id} className="hover:bg-slate-50">
                      <td className="px-4 py-3 font-semibold text-slate-950">{p.school_teachers?.name || "-"}</td>
                      <td className="px-4 py-3 text-slate-500">{new Date(p.paid_at).toLocaleDateString()}</td>
                      <td className="px-4 py-3 text-right font-bold text-slate-950">{formatMoney(p.amount)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

export default function SchoolTeachers() {
  const [tab, setTab] = useState("people"); // people | salaries

  return (
    <div className="space-y-4">
      <div className="flex w-fit rounded-full bg-slate-100 p-1">
        {[["people", "Teachers"], ["salaries", "Salary Payments"]].map(([key, label]) => (
          <button
            key={key}
            onClick={() => setTab(key)}
            className={`rounded-full px-4 py-2 text-sm font-bold transition ${tab === key ? "bg-blue-600 text-white shadow-sm" : "text-slate-500 hover:text-slate-950"}`}
          >
            {label}
          </button>
        ))}
      </div>

      {tab === "people" ? (
        <EntityCrud
          apiPath="/school/teachers"
          title="Add Teacher"
          emptyTitle="No teachers yet"
          emptyDescription="Add your first teacher to start assigning classes."
          fields={[
            { key: "name", label: "Full name", required: true },
            { key: "phone", label: "Phone number" },
            { key: "subject", label: "Subject" },
            { key: "monthly_salary", label: "Monthly salary", type: "number" },
          ]}
          columns={[
            { key: "name", label: "Name" },
            { key: "subject", label: "Subject" },
            { key: "phone", label: "Phone" },
            { key: "monthly_salary", label: "Salary", align: "right", render: (r) => formatMoney(r.monthly_salary) },
            { key: "status", label: "Status", render: (r) => <span className={`rounded-full px-2 py-0.5 text-xs font-bold ${r.status === "active" ? "bg-green-50 text-green-700" : "bg-slate-100 text-slate-500"}`}>{r.status}</span> },
          ]}
        />
      ) : (
        <SalaryPayments />
      )}
    </div>
  );
}

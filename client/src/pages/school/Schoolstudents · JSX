import React, { useEffect, useState } from "react";
import { Trash2, Users } from "lucide-react";
import { apiRequest, formatMoney } from "../../lib/api";
import { EmptyState, ErrorState, LoadingState } from "../../components/AsyncState";

export default function SchoolStudents() {
  const [students, setStudents] = useState([]);
  const [classes, setClasses] = useState([]);
  const [form, setForm] = useState({ name: "", class_id: "", guardian_name: "", guardian_phone: "", monthly_fee: "" });
  const [status, setStatus] = useState({ loading: true, saving: false, error: "" });

  async function load() {
    setStatus((s) => ({ ...s, loading: true, error: "" }));
    try {
      const [studentsRes, classesRes] = await Promise.all([
        apiRequest("/school/students"),
        apiRequest("/school/classes"),
      ]);
      setStudents(studentsRes.data || []);
      setClasses(classesRes.data || []);
      setStatus((s) => ({ ...s, loading: false }));
    } catch (error) {
      setStatus((s) => ({ ...s, loading: false, error: error.message }));
    }
  }
  useEffect(() => { load(); }, []);
  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));

  async function handleSubmit(e) {
    e.preventDefault();
    setStatus((s) => ({ ...s, saving: true, error: "" }));
    try {
      await apiRequest("/school/students", { method: "POST", body: JSON.stringify(form) });
      setForm({ name: "", class_id: "", guardian_name: "", guardian_phone: "", monthly_fee: "" });
      setStatus((s) => ({ ...s, saving: false }));
      await load();
    } catch (error) {
      setStatus((s) => ({ ...s, saving: false, error: error.message }));
    }
  }

  async function handleDelete(id) {
    if (!window.confirm("Remove this student?")) return;
    try {
      await apiRequest(`/school/students/${id}`, { method: "DELETE" });
      await load();
    } catch (error) {
      setStatus((s) => ({ ...s, error: error.message }));
    }
  }

  if (status.loading) return <LoadingState />;

  return (
    <div className="grid gap-5 xl:grid-cols-[380px_1fr]">
      <form onSubmit={handleSubmit} className="panel h-fit p-4">
        <h2 className="mb-4 flex items-center gap-2 text-base font-bold text-slate-950">
          <Users className="h-5 w-5 text-blue-600" /> Add Student
        </h2>
        {status.error ? <ErrorState message={status.error} /> : null}
        <div className="space-y-3">
          <input className="field" placeholder="Student name" value={form.name} onChange={(e) => set("name", e.target.value)} required />
          <select className="field" value={form.class_id} onChange={(e) => set("class_id", e.target.value)}>
            <option value="">Assign class (optional)</option>
            {classes.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <input className="field" placeholder="Guardian name" value={form.guardian_name} onChange={(e) => set("guardian_name", e.target.value)} />
          <input className="field" placeholder="Guardian phone" value={form.guardian_phone} onChange={(e) => set("guardian_phone", e.target.value)} />
          <input className="field" type="number" min="0" step="0.01" placeholder="Monthly fee" value={form.monthly_fee} onChange={(e) => set("monthly_fee", e.target.value)} />
        </div>
        <button className="btn-primary mt-4 w-full" disabled={status.saving}>{status.saving ? "Saving…" : "Add student"}</button>
      </form>

      <div className="panel overflow-hidden">
        {students.length === 0 ? (
          <div className="p-4"><EmptyState title="No students yet" description="Add your first student to start tracking fees." /></div>
        ) : (
          <div className="overflow-x-auto">
            <table className="min-w-full text-left text-sm">
              <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                <tr><th className="px-4 py-3 font-semibold">Name</th><th className="px-4 py-3 font-semibold">Class</th><th className="px-4 py-3 font-semibold">Guardian</th><th className="px-4 py-3 text-right font-semibold">Monthly fee</th><th className="px-4 py-3 text-right font-semibold">Action</th></tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {students.map((s) => (
                  <tr key={s.id} className="hover:bg-slate-50">
                    <td className="px-4 py-3 font-semibold text-slate-950">{s.name}</td>
                    <td className="px-4 py-3 text-slate-600">{s.school_classes?.name || "Unassigned"}</td>
                    <td className="px-4 py-3 text-slate-600">{s.guardian_name || "-"} {s.guardian_phone ? `· ${s.guardian_phone}` : ""}</td>
                    <td className="px-4 py-3 text-right font-bold text-slate-950">{formatMoney(s.monthly_fee)}</td>
                    <td className="px-4 py-3 text-right">
                      <button type="button" className="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-red-100 text-red-600 transition hover:bg-red-50" onClick={() => handleDelete(s.id)}>
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}

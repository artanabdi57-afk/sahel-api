import React, { useEffect, useState } from "react";
import { ClipboardCheck, Trash2, Save } from "lucide-react";
import { apiRequest } from "../../lib/api";
import { EmptyState, ErrorState, LoadingState } from "../../components/AsyncState";

function ResultsEntry({ exam, onClose }) {
  const [students, setStudents] = useState([]);
  const [existing, setExisting] = useState({});
  const [scores, setScores] = useState({});
  const [status, setStatus] = useState({ loading: true, saving: false, error: "", success: "" });

  useEffect(() => {
    (async () => {
      try {
        const [studentsRes, resultsRes] = await Promise.all([
          apiRequest(`/school/students${exam.class_id ? `?class_id=${exam.class_id}` : ""}`),
          apiRequest(`/school/exams/${exam.id}/results`),
        ]);
        setStudents(studentsRes.data || []);
        const map = {};
        (resultsRes.data || []).forEach((r) => { map[r.student_id] = r.score; });
        setExisting(map);
        setScores(map);
        setStatus((s) => ({ ...s, loading: false }));
      } catch (error) {
        setStatus((s) => ({ ...s, loading: false, error: error.message }));
      }
    })();
  }, [exam.id]);

  async function handleSave() {
    setStatus((s) => ({ ...s, saving: true, error: "", success: "" }));
    try {
      const results = Object.entries(scores)
        .filter(([, score]) => score !== "" && score !== undefined && score !== null)
        .map(([student_id, score]) => ({ student_id, score: Number(score) }));
      await apiRequest(`/school/exams/${exam.id}/results`, { method: "POST", body: JSON.stringify({ results }) });
      setStatus((s) => ({ ...s, saving: false, success: "Results saved." }));
    } catch (error) {
      setStatus((s) => ({ ...s, saving: false, error: error.message }));
    }
  }

  if (status.loading) return <LoadingState />;

  return (
    <div className="panel p-4">
      <div className="mb-4 flex items-center justify-between">
        <h2 className="text-base font-bold text-slate-950">Results — {exam.name} <span className="font-medium text-slate-400">(out of {exam.max_score})</span></h2>
        <button className="text-sm font-bold text-blue-600" onClick={onClose}>Close</button>
      </div>
      {status.error ? <ErrorState message={status.error} /> : null}
      {status.success ? <div className="mb-4 rounded-lg bg-green-50 p-3 text-sm font-medium text-green-700">{status.success}</div> : null}

      {students.length === 0 ? (
        <EmptyState title="No students in this class" description="Assign students to this exam's class first." />
      ) : (
        <div className="space-y-2">
          {students.map((s) => (
            <div key={s.id} className="flex items-center justify-between gap-3 rounded-lg border border-slate-100 px-3 py-2">
              <span className="font-semibold text-slate-800">{s.name}</span>
              <input
                type="number"
                min="0"
                max={exam.max_score}
                className="field w-28 text-right"
                placeholder={existing[s.id] !== undefined ? String(existing[s.id]) : "score"}
                value={scores[s.id] ?? ""}
                onChange={(e) => setScores((sc) => ({ ...sc, [s.id]: e.target.value }))}
              />
            </div>
          ))}
          <button className="btn-primary mt-3" onClick={handleSave} disabled={status.saving}>
            <Save className="h-4 w-4" />
            {status.saving ? "Saving…" : "Save results"}
          </button>
        </div>
      )}
    </div>
  );
}

export default function SchoolExams() {
  const [exams, setExams] = useState([]);
  const [classes, setClasses] = useState([]);
  const [form, setForm] = useState({ name: "", class_id: "", exam_date: "", max_score: "100" });
  const [openExam, setOpenExam] = useState(null);
  const [status, setStatus] = useState({ loading: true, saving: false, error: "" });

  async function load() {
    setStatus((s) => ({ ...s, loading: true, error: "" }));
    try {
      const [examsRes, classesRes] = await Promise.all([
        apiRequest("/school/exams"),
        apiRequest("/school/classes"),
      ]);
      setExams(examsRes.data || []);
      setClasses(classesRes.data || []);
      setStatus((s) => ({ ...s, loading: false }));
    } catch (error) {
      setStatus((s) => ({ ...s, loading: false, error: error.message }));
    }
  }
  useEffect(() => { load(); }, []);
  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));

  async function handleSubmit(e) {
    e.preventDefault();
    setStatus((s) => ({ ...s, saving: true, error: "" }));
    try {
      await apiRequest("/school/exams", { method: "POST", body: JSON.stringify({ ...form, max_score: Number(form.max_score) || 100 }) });
      setForm({ name: "", class_id: "", exam_date: "", max_score: "100" });
      setStatus((s) => ({ ...s, saving: false }));
      await load();
    } catch (error) {
      setStatus((s) => ({ ...s, saving: false, error: error.message }));
    }
  }

  async function handleDelete(id) {
    if (!window.confirm("Remove this exam and all its results?")) return;
    try {
      await apiRequest(`/school/exams/${id}`, { method: "DELETE" });
      await load();
    } catch (error) {
      setStatus((s) => ({ ...s, error: error.message }));
    }
  }

  if (status.loading) return <LoadingState />;
  if (openExam) return <ResultsEntry exam={openExam} onClose={() => setOpenExam(null)} />;

  return (
    <div className="grid gap-5 xl:grid-cols-[380px_1fr]">
      <form onSubmit={handleSubmit} className="panel h-fit p-4">
        <h2 className="mb-4 flex items-center gap-2 text-base font-bold text-slate-950">
          <ClipboardCheck className="h-5 w-5 text-blue-600" /> Add Exam
        </h2>
        {status.error ? <ErrorState message={status.error} /> : null}
        <div className="space-y-3">
          <input className="field" placeholder="Exam name (e.g. Term 1 Final)" value={form.name} onChange={(e) => set("name", e.target.value)} required />
          <select className="field" value={form.class_id} onChange={(e) => set("class_id", e.target.value)}>
            <option value="">Choose class</option>
            {classes.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <input className="field" type="date" value={form.exam_date} onChange={(e) => set("exam_date", e.target.value)} />
          <input className="field" type="number" min="1" placeholder="Max score (default 100)" value={form.max_score} onChange={(e) => set("max_score", e.target.value)} />
        </div>
        <button className="btn-primary mt-4 w-full" disabled={status.saving}>{status.saving ? "Saving…" : "Add exam"}</button>
      </form>

      <div className="panel overflow-hidden">
        {exams.length === 0 ? (
          <div className="p-4"><EmptyState title="No exams yet" description="Add your first exam, then enter student scores." /></div>
        ) : (
          <div className="overflow-x-auto">
            <table className="min-w-full text-left text-sm">
              <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                <tr><th className="px-4 py-3 font-semibold">Exam</th><th className="px-4 py-3 font-semibold">Class</th><th className="px-4 py-3 font-semibold">Date</th><th className="px-4 py-3 text-right font-semibold">Action</th></tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {exams.map((ex) => (
                  <tr key={ex.id} className="hover:bg-slate-50">
                    <td className="px-4 py-3 font-semibold text-slate-950">{ex.name}</td>
                    <td className="px-4 py-3 text-slate-600">{ex.school_classes?.name || "-"}</td>
                    <td className="px-4 py-3 text-slate-500">{ex.exam_date ? new Date(ex.exam_date).toLocaleDateString() : "-"}</td>
                    <td className="px-4 py-3 text-right">
                      <div className="flex items-center justify-end gap-2">
                        <button type="button" className="btn-secondary" onClick={() => setOpenExam(ex)}>Enter scores</button>
                        <button type="button" className="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-red-100 text-red-600 transition hover:bg-red-50" onClick={() => handleDelete(ex.id)}>
                          <Trash2 className="h-4 w-4" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
